{
  "name": "referraleasy",
  "version": "0.0.0",
  "private": true,
  "description": "ReferralEasy — portfolio demo platform (ADK + A2A multi-agent patient referral)",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "gen:contracts": "pnpm --filter @referraleasy/contracts gen",
    "mock-api:dev": "pnpm --filter @referraleasy/mock-api dev",
    "web:dev": "pnpm --filter @referraleasy/web dev"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
