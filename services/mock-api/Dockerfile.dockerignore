# Build context is the repository root. Include only this Dockerfile's COPY inputs.
# This file overrides the root .dockerignore. Keep private exclusions last.
**

!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!packages
!packages/contracts
!packages/contracts/ts
!packages/contracts/ts/package.json
!packages/contracts/ts/tsconfig.json
!packages/contracts/ts/src
!packages/contracts/ts/src/**
!services
!services/mock-api
!services/mock-api/package.json
!services/mock-api/tsconfig.json
!services/mock-api/tsconfig.build.json
!services/mock-api/src
!services/mock-api/src/**
!fixtures
!fixtures/**

# Never send private configuration, history, or local artifacts to a builder.
**/.git
**/.env
**/.env.*
**/secrets
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/MEMORY.md
**/.agents
**/.codex
**/.aws
**/.ssh
**/.DS_Store
**/node_modules
**/.venv
**/venv
**/.audio-venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.cache
**/.playwright-mcp
**/.argent
**/.data
**/volumes
**/.pgdata
**/.opensearch
**/dist
**/build
**/out
**/qa
**/logs
**/*.log
**/*.tsbuildinfo
