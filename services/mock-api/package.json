{
  "name": "@referraleasy/mock-api",
  "version": "0.1.0",
  "private": true,
  "description": "ReferralEasy mock hospital network API — directory, coverage, availability, booking lifecycle and fault injection.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@referraleasy/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  }
}
