# ════════════════════════════════════════════════════════════════════════════
# ReferralEasy — environment contract
# Source of truth: ReferralEasy_Architecture_v3.md §19
# Additions are marked [ADR-0001] and documented in
# docs/adr/ADR-0001-language-tooling-and-repo-layout.md
#
#   cp .env.example .env    then review.  Secrets never enter the repo.
# ════════════════════════════════════════════════════════════════════════════
#
# ⚠  PHASE 0 NOT COMPLETE — the values marked CHANGEME are NOT real
#    configuration. IMPLEMENTATION_TODO.md §0.2 requires each one to be pinned
#    by a spike that ends in a dated ADR plus a passing smoke test. Those
#    spikes call live providers, and no provider credentials exist in this
#    environment yet, so the pins below remain open.
#
#    Run `make spike` once credentials exist (OPENROUTER_API_KEY /
#    VERTEX_PROJECT_ID / LANGSMITH_API_KEY). Until then the demo runs on
#    MODEL_BACKEND=offline — canned model/embedding/rerank responses, no
#    network, no credentials, every response flagged synthetic in traces.
#
#    scripts/validate_env.py fails loudly if a `live` backend is selected while
#    any CHANGEME pin is still present. It never silently substitutes a default.
# ════════════════════════════════════════════════════════════════════════════

APP_ENV=demo

# ─── budgets, deadlines, retries (§8) ───────────────────────────────────────
AGENT_ATTEMPT_TIMEOUT_MS=3000
AGENT_MAX_ATTEMPTS=3
TURN_DEADLINE_MS=30000
MAX_DELEGATIONS_PER_TURN=8
MAX_MODEL_CALLS_PER_TURN=12
MAX_TOOL_CALLS_PER_TURN=16
HTTP_TOOL_TIMEOUT_MS=1500
FALLBACK_TIMEOUT_MS=3000
RETRY_BACKOFF_BASE_MS=150
RETRY_BACKOFF_MAX_MS=500

# ─── guardrails (§9) ────────────────────────────────────────────────────────
GUARDRAIL_MODE=three_stage
# The read timeout handed to httpx for the decision-model call — a *per-phase* timeout, not a
# wall-clock budget over all three layers, so it must exceed one model call and not the sum of them.
# ADR-0038 measured the pinned model at 5.39-5.44 s live; the 3000 this carried closed layer 2 with a
# ReadTimeout on every message, which is silent in the sense that matters — the service looks healthy
# and refuses every write. Raise it if you pin a slower model.
GUARDRAIL_TOTAL_TIMEOUT_MS=8000
# Layer 2's pinned model. ADR-0038 measured this one live on 2026-10-15 (5.4 s, $0.00017 per
# screening) and ADR-0037 records that the pin resolver refuses a token that is not a resolved model
# id — `CEV`, `tbd` and a vendor-less `gpt-5-nano` are all refused at startup rather than used. It
# still needs OPENROUTER_API_KEY below; with the key absent the layer closes and §9 refuses writes.
GUARDRAIL_DECISION_MODEL=openai/gpt-5-nano
# Layer 3, as the *offline rung*: a deterministic local character-ngram encoder that ships with the
# package and needs no download. The pinned ONNX encoder is the better model and needs a ~23 MB
# artifact; naming it without the artifact present closes the layer (which is correct — nothing is
# substituted silently), so the rung is what a fresh checkout gets. Switch to the pinned artifact by
# naming it (`GUARDRAIL_LOCAL_MODEL` in ADR-0005) once it is in `data/`.
GUARDRAIL_LOCAL_MODEL=offline/hashed-char-ngram-v1
# Must equal the committed record's value (`data/threshold_record.json`, measured 2026-10-15 over
# `labelled-corpus-v1`). It is not a preference: the classifier layer closes itself when the
# environment threshold differs from the recorded one, because a threshold nobody calibrated is not a
# threshold.
GUARDRAIL_LOCAL_THRESHOLD=0.32

# ─── agent model provider (§8) ──────────────────────────────────────────────
AGENT_MODEL_PROVIDER=openrouter
AGENT_MODEL_ID=CHANGEME_TOOL_CAPABLE_MODEL
OPENROUTER_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=CHANGEME_SUPPORTED_REGION
VERTEX_AGENT_MODEL_ID=CHANGEME_FLASH_MODEL

# ─── embeddings / rerank / RAG (§8, §10) ────────────────────────────────────
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RERANK_PROVIDER=openrouter
RERANK_MODEL_ID=cohere/rerank-v3.5

# ─── evaluation (§14) ───────────────────────────────────────────────────────
EVAL_SAMPLE_RATE=0.01
EVAL_CRON=0 0,12 * * *
EVAL_TIMEZONE=America/Chicago
EVAL_SAMPLE_SEED=CHANGEME_STABLE_SECRET_SEED
EVAL_JUDGE_MODEL_ID=CHANGEME_JUDGE_MODEL
LANGSMITH_ENABLED=true
LANGSMITH_API_KEY=
# Required alongside LANGSMITH_API_KEY: the OTLP exporter sends `Langsmith-Project` as a header,
# so tracing cannot be enabled without it. See docs/adr/ADR-0010.
LANGSMITH_PROJECT=CHANGEME_LANGSMITH_PROJECT

# ─── telemetry & storage (§15) ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OPENSEARCH_URL=http://opensearch:9200
DATABASE_URL=postgresql://referraleasy:referraleasy@localhost:5432/referraleasy

# ─── [ADR-0023] host ports ──────────────────────────────────────────────────
# The port `postgres` publishes on the HOST. Must agree with the port in DATABASE_URL.
# Raise this if 5432 is already taken by something else on your machine.
POSTGRES_HOST_PORT=5432

# ─── gateway (§5, §12) ──────────────────────────────────────────────────────
# The host-reachable address of the gateway container. It is what `scripts/health.py` probes and
# what `apps/web` calls; inside the compose network the same service answers on `gateway:8080`.
GATEWAY_URL=http://localhost:8080
# `postgres` for the demo (§7: the database is the primary store), `memory` to run the gateway with
# no database at all — which is how its unit suite runs. The Postgres adapter refuses to start
# against an unmigrated database rather than serving in-memory state under a postgres label.
GATEWAY_CONTROL_BACKEND=postgres

# ─── mock hospital API (§17) ────────────────────────────────────────────────
MOCK_API_URL=http://localhost:4010
MOCK_FAULT_SEED=42

# ─── alerts (§16) ───────────────────────────────────────────────────────────
ALERT_FAILURE_RATE_THRESHOLD=0.20
ALERT_MIN_INVOCATIONS=20
ALERT_WINDOW_SECONDS=300
ALERT_COOLDOWN_SECONDS=900

# ─── service auth (§5, §9) ──────────────────────────────────────────────────
# [ADR-0001] Local-only fixtures, validated for real in tests (NOT a bypass).
# Cloud Run profile replaces these with audience-checked service identity.
JWT_PATIENT_SECRET=CHANGEME_LOCAL_FIXTURE_SECRET
JWT_ADMIN_SECRET=CHANGEME_LOCAL_FIXTURE_SECRET
A2A_SERVICE_TOKEN=CHANGEME_LOCAL_FIXTURE_TOKEN

# ════════════════════════════════════════════════════════════════════════════
# [ADR-0001] Offline-fixture profile (§18)
# ────────────────────────────────────────────────────────────────────────────
# offline → canned model / embedding / rerank responses. Zero network calls,
#           zero credentials. Every artefact carries `synthetic: true` so no
#           admin chart can present canned output as a real measurement
#           (invariant: "no fabricated demo charts").
# live    → the provider backends above are used and their pins must be
#           resolved first.
MODEL_BACKEND=offline
EMBEDDING_BACKEND=offline
RERANK_BACKEND=offline
# The offline profile is always labelled in the UI and in traces (§18).
OFFLINE_PROFILE_LABEL=OFFLINE FIXTURE PROFILE — canned model responses
