{
  "name": "@referraleasy/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated Zod bindings for the ReferralEasy contract schemas (single source: ../schemas)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "gen": "node scripts/gen-zod.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'linted via root tsc/vitest'"
  },
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "json-schema-to-zod": "^2.6.1",
    "typescript": "5.7.3",
    "vitest": "^3.0.5"
  }
}
