{
  "name": "Protect default branch",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash", "rebase"],
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_approving_review_count": 0,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "No secrets in the tree or the history"
          },
          {
            "context": "Lint (ruff)"
          },
          {
            "context": "Type-check (mypy)"
          },
          {
            "context": "Tests (unit + contract, no spikes)"
          },
          {
            "context": "Integration tests (real PostgreSQL)"
          },
          {
            "context": "Scripted end-to-end booking"
          },
          {
            "context": "Version gate (a changed artifact must bump its version)"
          },
          {
            "context": "Generated bindings match the schemas"
          },
          {
            "context": "Env guard (offline passes, live+CHANGEME fails)"
          },
          {
            "context": "The demo scripts never claim work they did not do"
          },
          {
            "context": "JS lint + typecheck"
          }
        ]
      }
    }
  ]
}
